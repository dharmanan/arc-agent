{
  "name": "arc-agent-backend",
  "version": "1.0.0",
  "description": "Arc Machina — event-driven serverless-ready backend for the agentic wallet",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/db/migrate.js",
    "db:snapshot": "node scripts/dbSnapshot.js",
    "test": "npx -y jest@30.4.2 --runInBand",
    "smoke:route": "npm test -- src/routes/__tests__/routeSmoke.test.js",
    "smoke:paid-readiness": "node scripts/paidReadinessSmoke.js",
    "smoke:automation-live": "node scripts/automationLiveSmoke.js",
    "smoke:defi-full": "node scripts/defiFullSmoke.js",
    "smoke:readiness": "npm run smoke:route && npm run smoke:paid-readiness",
    "jobs:smoke:e2e": "node scripts/jobsE2ESmoke.js",
    "oracle:buyer:example": "node examples/oraclePublicBuyerExample.js",
    "oracle:buyer:preview": "node examples/oraclePublicBuyerExample.js --preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@circle-fin/adapter-ethers-v6": "^1.7.0",
    "@circle-fin/swap-kit": "^1.2.2",
    "@circle-fin/x402-batching": "^3.0.4",
    "@coral-xyz/anchor": "^0.32.1",
    "@simplewebauthn/server": "^13.3.0",
    "@x402/core": "^2.13.0",
    "@x402/evm": "^2.13.0",
    "@x402/express": "^2.12.0",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.4",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "openai": "^4.77.3",
    "pg": "^8.13.1",
    "uuid": "^11.0.5",
    "viem": "^2.52.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.7",
    "solc": "^0.8.24",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "bull": {
      "uuid": "11.1.1"
    },
    "jayson": {
      "uuid": "11.1.1"
    },
    "tmp": "0.2.6",
    "@solana/web3.js": {
      "ws": "8.20.1"
    },
    "ethers": {
      "ws": "8.20.1"
    },
    "openai": {
      "ws": "8.20.1"
    },
    "viem": {
      "ws": "8.20.1"
    }
  }
}
