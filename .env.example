# =============================================================================
# Arc Agent — Environment Variables
# Stack: Vercel (API) + Neon (PostgreSQL) + Upstash (Redis) + Railway (indexer)
# =============================================================================
# Copy this file to .env and fill in the values.
# LOCAL DEV: docker-compose up -d  → gives you Postgres + Redis for free.
# =============================================================================

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Your deployed Vercel frontend URL (or localhost for dev)
FRONTEND_URL=http://localhost:5500

# ─── Database ─────────────────────────────────────────────────────────────────
# LOCAL:      postgresql://arc:arc_secret@localhost:5432/arc_agent
# NEON:       copy "Connection string" from Neon dashboard → pooled connection
DATABASE_URL=postgresql://arc:arc_secret@localhost:5432/arc_agent

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# UPSTASH FREE TIER: 500k commands/month — this config stays well under that.
#
# How to get REDIS_URL:
#   1. upstash.com → Create Database → Redis
#   2. Dashboard → "Connect" → copy ".env" tab value
#   Format: rediss://default:<password>@<region>.upstash.io:6379
#
# LOCAL DEV: leave REDIS_URL empty, Docker Redis is used automatically
REDIS_URL=

# Local Docker fallback (only used when REDIS_URL is empty)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ─── JWT (REQUIRED) ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_32_chars_use_crypto_randomBytes_32
JWT_EXPIRES_IN=24h

# ─── WebAuthn / Passkey (REQUIRED) ────────────────────────────────────────────
# RP_ID    = domain only, no protocol/port  (localhost for dev)
# ORIGIN   = full URL users access the frontend from
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Arc Machina
WEBAUTHN_ORIGIN=http://localhost:5500

# ─── Encryption (REQUIRED) ────────────────────────────────────────────────────
# Encrypts user LLM API keys stored in DB (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_use_crypto_randomBytes_32

# ─── Blockchain (REQUIRED) ────────────────────────────────────────────────────
# Arc Testnet — get free RPC from https://arc.network or use public endpoint
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Other chains — public RPCs work fine for testnet
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC=https://mainnet.base.org
OPTIMISM_RPC=https://mainnet.optimism.io
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# ─── Relayer wallet (REQUIRED) ────────────────────────────────────────────────
# A dedicated wallet funded with gas only — NEVER holds user funds
# Create a fresh MetaMask wallet, export private key, fund with testnet ETH
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY

# ─── Deployed contract addresses (fill after: npm run deploy:arc) ─────────────
FACTORY_ADDRESS=

# USDC addresses per chain
USDC_ADDRESS_ARC=0x3600000000000000000000000000000000000000
USDC_ADDRESS_SEPOLIA=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
USDC_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ─── Agentic Execution / Nano Payments ────────────────────────────────────────
# Reference: https://developers.circle.com/gateway/nanopayments#agentic-payments
#
# EURC (Euro Coin by Circle) — Arc Testnet adresi Circle SDK'dan alındı
# Kaynak: @circle-fin/bridge-kit → ArcTestnet.eurcAddress
EURC_ADDRESS_ARC=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# Circle App Kit / Swap Kit key from Circle Console.
# Required for Arc Testnet USDC↔EURC swap quotes and execution.
CIRCLE_KIT_KEY=

# Max gas price the agent will pay (in gwei) for autonomous transactions
AGENT_MAX_GAS_GWEI=50

# ─── LLM (OPTIONAL) ───────────────────────────────────────────────────────────
# Users provide their own API keys via the UI — stored encrypted in DB.
# These are only used as a platform fallback if you want shared smart mode.
# Leave blank if every user will bring their own key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# How long to cache shared market analysis responses in Redis (seconds)
LLM_CACHE_TTL=300

# ─── Circle Bridge (OPTIONAL) ─────────────────────────────────────────────────
# Only needed if you enable cross-chain USDC bridging via Circle CCTP
CIRCLE_API_KEY=
