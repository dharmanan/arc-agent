# =============================================================================
# Arc Agent — Environment Variables
# Stack: Vercel (frontend) + Railway Postgres + Upstash (Redis) + Railway (backend)
# =============================================================================
# Copy this file to .env and fill in the values.
# LOCAL DEV: docker-compose up -d  → gives you Postgres + Redis for free.
# =============================================================================

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Your deployed Vercel frontend URL (or localhost for dev)
FRONTEND_URL=

# ─── Database ─────────────────────────────────────────────────────────────────
# LOCAL DOCKER: postgresql://arc:arc_secret@localhost:5432/arc_agent
# RAILWAY LOCAL/DEVCONTAINER: use Railway Postgres DATABASE_PUBLIC_URL
# RAILWAY INTERNAL: postgres.railway.internal only works inside Railway runtime
DATABASE_URL=

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# UPSTASH FREE TIER: 500k commands/month — this config stays well under that.
#
# How to get REDIS_URL:
#   1. upstash.com → Create Database → Redis
#   2. Dashboard → "Connect" → copy ".env" tab value
#   Format: rediss://default:<password>@<region>.upstash.io:6379
#
# LOCAL DEV: leave REDIS_URL empty, Docker Redis is used automatically
REDIS_URL=

# Local Docker fallback (only used when REDIS_URL is empty)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT (REQUIRED) ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ─── WebAuthn / Passkey (REQUIRED) ────────────────────────────────────────────
# RP_ID    = domain only, no protocol/port  (localhost for dev)
# ORIGIN   = full URL users access the frontend from
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Arc Machina
WEBAUTHN_ORIGIN=

# ─── Encryption (REQUIRED) ────────────────────────────────────────────────────
# Encrypts user LLM API keys stored in DB (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Blockchain (REQUIRED) ────────────────────────────────────────────────────
# Arc Testnet — use a dedicated or higher-limit RPC in hosted deployments.
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
# Optional override used by shared Arc provider helpers.
ARC_RPC_URL=
# Optional comma-separated Arc RPC pool (preferred for production resilience).
# Keep ARC_RPC_URL for backward compatibility; if ARC_RPC_URLS is set, it is used as the provider pool.
ARC_RPC_URLS=
# Cooldown window applied when an Arc endpoint returns rate-limit responses.
ARC_RPC_RATE_LIMIT_COOLDOWN_MS=120000
# Optional separate RPC for the chain-event indexer. Strongly recommended on Railway.
ARC_TESTNET_INDEXER_RPC=
ARC_CHAIN_ID=5042002

# Other chains — public RPCs work fine for light testnet usage.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_INDEXER_RPC=
BASE_RPC=https://mainnet.base.org
OPTIMISM_RPC=https://mainnet.optimism.io
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# ─── Relayer wallet (REQUIRED) ────────────────────────────────────────────────
# A dedicated wallet funded with gas only — NEVER holds user funds
# Create a fresh MetaMask wallet, export private key, fund with testnet ETH
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY

# ─── Deployed contract addresses ─────────────────────────────────────────────
# These are already deployed on Arc Testnet — no need to redeploy.
FACTORY_ADDRESS=
AGENTIC_COMMERCE_ADDRESS=

# USDC addresses per chain
USDC_ADDRESS_ARC=
USDC_ADDRESS_SEPOLIA=
USDC_ADDRESS_BASE=

# ─── Agentic Execution / Nano Payments ────────────────────────────────────────
# Reference: https://developers.circle.com/gateway/nanopayments#agentic-payments
#
# EURC (Euro Coin by Circle) — Arc Testnet adresi Circle SDK'dan alındı
# Kaynak: @circle-fin/bridge-kit → ArcTestnet.eurcAddress
EURC_ADDRESS_ARC=

# Circle App Kit / Swap Kit key from Circle Console.
# Required for Arc Testnet USDC↔EURC swap quotes and execution.
CIRCLE_KIT_KEY=

# Max gas price the agent will pay (in gwei) for autonomous transactions
AGENT_MAX_GAS_GWEI=50

# ─── LLM (OPTIONAL) ───────────────────────────────────────────────────────────
# Users provide their own API keys via the UI — stored encrypted in DB.
# These are only used as a platform fallback if you want shared smart mode.
# Leave blank if every user will bring their own key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# How long to cache shared market analysis responses in Redis (seconds)
LLM_CACHE_TTL=300

# ─── Circle Bridge (OPTIONAL) ─────────────────────────────────────────────────
# Only needed if you enable cross-chain USDC bridging via Circle CCTP
CIRCLE_API_KEY=

# ── Circle CCTP V2 Contracts (Arc Testnet) ────────────────────────────────────
ARC_CCTP_TOKEN_MESSENGER=
ARC_CCTP_MESSAGE_TRANSMITTER=

# ── Circle Gateway Contracts (Arc Testnet) ────────────────────────────────────
ARC_GATEWAY_WALLET=
ARC_GATEWAY_MINTER=
ARC_BRIDGEKIT_CONTRACT=

# ─── Oracle-as-a-Service (x402 Nanopayment) ───────────────────────────────────
# Wallet address that receives USDC payments for oracle queries.
# WARNING: leaving this empty will hard-fail all /api/oracle/public/* endpoints.
ORACLE_PAY_ADDRESS=

# ─── Reputation Registry (ERC-8004) ───────────────────────────────────────────
# Leave empty to skip on-chain calls (DB-only reputation tracking).
REPUTATION_REGISTRY_ADDRESS=

# ─── Hosted Background Jobs / RPC Safety ──────────────────────────────────────
# Keep BACKGROUND_JOBS_ENABLED=false for first Railway boot if the RPC is rate-limited.
# Then enable one lane at a time after the API is stable.
BACKGROUND_JOBS_ENABLED=true
DRY_RUN=true
CHAIN_EVENT_RETENTION_ENABLED=true
JOB_RETENTION_ENABLED=true
SECURITY_FREEZE_RECOVERY_ENABLED=true
LP_REWARD_SNAPSHOT_ENABLED=false
INDEXER_ENABLED=false
BRIDGE_POLLER_ENABLED=false
ORACLE_LOOP_ENABLED=false
MARKET_ANALYSIS_LOOP_ENABLED=false
DEFI_LOOP_ENABLED=false
DAILY_TASKS_ENABLED=false
QUEUE_WORKERS_ENABLED=false
QUEUE_WORKER_STARTUP_DELAY_MS=300000

# ─── Indexer Tuning ───────────────────────────────────────────────────────────
INDEXER_POLL_INTERVAL_MS=120000
INDEXER_BACKFILL_BLOCKS=25
INDEXER_BLOCK_CHUNK_SIZE=25
INDEXER_WALLET_CHUNK_SIZE=5
INDEXER_RATE_LIMIT_BACKOFF_MS=120000

# Emergency Railway safe mode for a rate-limited RPC:
# BACKGROUND_JOBS_ENABLED=false
# or keep BACKGROUND_JOBS_ENABLED=true and set high-load lanes to false:
# INDEXER_ENABLED=false
# BRIDGE_POLLER_ENABLED=false
# ORACLE_LOOP_ENABLED=false
# MARKET_ANALYSIS_LOOP_ENABLED=false
# DEFI_LOOP_ENABLED=false
# DAILY_TASKS_ENABLED=false
# LP_REWARD_SNAPSHOT_ENABLED=false
# QUEUE_WORKERS_ENABLED=false

# ─── Autonomous Features ──────────────────────────────────────────────────────
# Set DRY_RUN=false to enable real on-chain execution in autonomous loops.
DRY_RUN=true
DEFI_LOOP_INTERVAL_MS=3600000
ORACLE_LOOP_INTERVAL_MS=1800000
DAILY_TASK_INTERVAL_MS=86400000
DAILY_FREE_TASK_CAP=5

# cirBTC LP global guard (all agents):
# If recent direct LP add failures spike across multiple agents, temporarily pause
# cirBTC add-liquidity actions to avoid repeated failing tx attempts.
CIRBTC_GLOBAL_GUARD_WINDOW_MINUTES=30
CIRBTC_GLOBAL_GUARD_COOLDOWN_MINUTES=45
CIRBTC_GLOBAL_GUARD_MIN_FAILURES=2
CIRBTC_GLOBAL_GUARD_MIN_AGENTS=2
CIRBTC_GLOBAL_GUARD_CACHE_MS=45000

# Processed chain_events rows are transient queue records; prune them aggressively
# to keep storage bounded on hosted Postgres.
CHAIN_EVENTS_RETENTION_DAYS=1
CHAIN_EVENTS_PRUNE_INTERVAL_MS=21600000
CHAIN_EVENTS_PRUNE_BATCH_SIZE=1000
CHAIN_EVENTS_PRUNE_MAX_BATCHES_PER_RUN=25

# Stale pending chain_events older than this window are reconciled on startup.
# Known agent-wallet matches are restored into receive transactions; orphaned
# rows with no matching agent wallet are deleted in batches.
CHAIN_EVENTS_STALE_PENDING_HOURS=48
CHAIN_EVENTS_STALE_PENDING_RESTORE_BATCH_SIZE=500
CHAIN_EVENTS_STALE_PENDING_DELETE_BATCH_SIZE=10000
CHAIN_EVENTS_STALE_PENDING_DELETE_MAX_BATCHES=120
